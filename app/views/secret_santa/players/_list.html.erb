<% if players.blank? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
  <div class="secret-santa-table-wrapper">
    <table class="list secret-santa-table">
      <thead>
        <tr>
          <th><%= l(:label_user) %></th>
          <th><%= l(:field_mail) %></th>
          <th class="secret-santa-col-actions"></th>
        </tr>
      </thead>
      <tbody>
        <% players.each do |player| %>
          <tr class="<%= 'is-current-user' if player.id == User.current.id %>">
            <td class="secret-santa-user-name"><%= player.user.name %></td>
            <td class="secret-santa-user-mail"><%= player.user.mail %></td>
            <td class="buttons secret-santa-col-actions"><%= player_actions(player) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
