<%= error_messages_for @player %>

<section class="box secret-santa-card">
  <%= form_for @player do |form| %>
    <div class="secret-santa-profile-summary">
      <p class="secret-santa-profile-name">
        <strong><%= "#{l(:label_member)}: #{User.current.name}" %></strong></p>
      <p class="secret-santa-profile-email">
        <strong><%= email_presence(User.current) %></strong>
      </p>
    </div>

    <div class="secret-santa-form-group">
      <%= form.label :want_to_get, l(:field_want_to_get) %>
      <%= form.text_area :want_to_get, rows: 4, cols: 60 %>
    </div>

    <div class="secret-santa-form-group">
      <%= form.label :dont_want_to_get, l(:field_dont_want_to_get) %>
      <%= form.text_area :dont_want_to_get, rows: 4, cols: 60 %>
    </div>

    <div class="secret-santa-form-actions">
      <%= form.submit l(:button_save), class: 'secret-santa-btn' %>
      <%= link_to l(:button_cancel), secret_santa_path, class: 'secret-santa-btn' %>
    </div>
  <% end %>
</section>