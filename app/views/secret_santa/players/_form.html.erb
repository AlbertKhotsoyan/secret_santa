<%= form_for @player do |form| %>
  <p><strong><%= User.current.name %></strong></p>
  <p><strong><%= email_presence(User.current) %></strong></p>

  <p>
    <%= form.label :want_to_get, l(:field_want_to_get) %><br>
    <%= form.text_area :want_to_get, rows: 4, cols: 60 %>
  </p>

  <p>
    <%= form.label :dont_want_to_get, l(:field_dont_want_to_get) %><br>
    <%= form.text_area :dont_want_to_get, rows: 4, cols: 60 %>
  </p>

  <%= form.submit l(:button_save) %>
<% end %>