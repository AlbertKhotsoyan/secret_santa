<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'secret_santa', plugin: 'secret_santa' %>
  <%= javascript_include_tag 'secret_santa_snow', plugin: 'secret_santa' %>
<% end %>

<div class="secret-santa-page">
  <div class="secret-santa-breadcrumb">
    <h2><%= link_to l(:label_secret_santa_games), secret_santa_path %> » <%= l(:button_show) %></h2>
  </div>

  <section class="box secret-santa-card">
    <div class="secret-santa-card-header">
      <div class="secret-santa-card-title">
        <h2><%= @game.name %></h2>
      </div>
      <div class="contextual">
        <%= button_to l(:button_edit), edit_secret_santa_game_path(@game), method: :get, class: 'btn btn-primary secret-santa-btn' %>
      </div>
    </div>

    <div class="secret-santa-letter-preview wiki">
      <%= textilizable(@game.message) %>
    </div>
  </section>

  <% if User.current.admin? %>
    <section class="box secret-santa-card">
      <div class="secret-santa-card-header">
        <div class="secret-santa-card-title">
          <h2><%= l(:label_secret_santa_players) %></h2>
          <% if @assignments.present? %>
            <span class="secret-santa-badge"><%= @assignments.size %></span>
          <% end %>
        </div>
      </div>

      <% if @assignments.present? %>
        <% unless @game.valid_assignments_cycle? %>
          <div class="secret-santa-hint">
            <p><%= l(:error_no_assignment_found) %></p>
          </div>
        <% end %>

        <div class="secret-santa-participants-grid">
          <% @assignments.each do |assignment| %>
            <div class="secret-santa-participant-item">
              <p>
                <span class="secret-santa-user-name"><%= assignment.giver.user.try(:name) %></span>
                <span class="secret-santa-user-mail">(<%= assignment.giver.user.try(:mail) %>)</span>
              </p>
            </div>
          <% end %>
        </div>

        <div class="secret-santa-toolbar">
          <%= button_to l(:label_update_players_list), draw_secret_santa_game_path(@game),
                        method: :post, class: 'btn btn-primary secret-santa-btn' %>

          <%= button_to l(:label_sent_emails), send_emails_secret_santa_game_path(@game),
                        method: :post, data: { confirm: l(:hint_send_emails) }, class: 'btn btn-primary secret-santa-btn' %>
        </div>
      <% else %>
        <p class="nodata"><%= l(:label_no_data) %></p>

        <div class="secret-santa-toolbar">
          <%= button_to l(:label_add_all_player_and_draw), draw_secret_santa_game_path(@game),
                        method: :post, class: 'btn btn-primary secret-santa-btn' %>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
