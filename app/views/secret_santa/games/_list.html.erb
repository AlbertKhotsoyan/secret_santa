<% if games.blank? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
  <div class="secret-santa-table-wrapper">
    <table class="list secret-santa-table">
      <thead>
        <tr>
          <th><%= l(:field_subject) %></th>
          <th class="secret-santa-col-actions"></th>
        </tr>
      </thead>
      <tbody>
        <% games.each do |game| %>
          <tr>
            <td><%= link_to game.name, secret_santa_game_path(game), class: 'secret-santa-game-link' %></td>
            <td class="buttons secret-santa-col-actions"><%= game_actions(game) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
